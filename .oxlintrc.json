{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "es2022": true
  },
  "overrides": [
    {
      "files": [
        "src/**/*.js",
        "src/**/*.jsx"
      ],
      "env": {
        "browser": true
      }
    },
    {
      "files": [
        "server/**/*.js",
        "tests/**/*.js"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "tests/**/*.js"
      ],
      "env": {
        "node": true,
        "browser": true
      }
    }
  ],
  "rules": {
    "no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  }
}
